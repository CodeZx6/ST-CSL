{
    "model": {
        "in_channels": 2,
        "base_channels": 128,
        "img_size": 32,
        "use_external": false
    },
    "training": {
        "n_epochs": 100,
        "batch_size": 32,
        "lr": 0.0001,
        "beta1": 0.9,
        "beta2": 0.999,
        "halve_epoch": 20,
        "val_interval": 20,
        "clip_grad": 5.0,
        "seed": 2021
    },
    "data": {
        "dataset": "BikeNYC",
        "data_root": "./data",
        "scaler_x": 1,
        "scaler_y": 1,
        "val_split": 0.05
    },
    "contrastive": {
        "embed_dim": 128,
        "margin": 0.0001,
        "loss_type": "softmax",
        "temperature": 0.1
    },
    "experiment": {
        "name": "bikenyc_baseline",
        "save_dir": "./experiments",
        "log_interval": 10
    }
}
